# Ollama server and model configuration
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3:8b
EMBEDDING_MODEL=nomic-embed-text

# Chunking (confirmed best-performing configuration by TruLens evaluation)
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=4

# Storage
INDEX_DIR=data/faiss_index

# Conversation memory trimming
MEMORY_MAX_TURNS=4
MEMORY_MAX_TOKENS=1500
